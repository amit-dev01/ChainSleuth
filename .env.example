# ==============================================================================
# ChainSleuth - Crypto Fraud Tracing & Attribution System
# Environment Configuration (.env.example)
# ==============================================================================

# Application Settings
APP_NAME=ChainSleuth
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-to-a-super-secret-hex-key-in-production-si2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
API_KEY_SECRET=chainsleuth-lea-internal-api-secret-key

# PostgreSQL Configuration
POSTGRES_USER=chainsleuth
POSTGRES_PASSWORD=chainsleuth_secure_pass_2026
POSTGRES_DB=chainsleuth_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://chainsleuth:chainsleuth_secure_pass_2026@postgres:5432/chainsleuth_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# Neo4j Graph Database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=chainsleuth_neo4j_pass_2026

# Celery Task Queue
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Blockchain Data Providers & APIs
# Tron (TronGrid API) - Primary chain for USDT-TRC20
TRONGRID_API_KEY=
TRON_GRID_URL=https://api.trongrid.io
TRON_FULL_NODE_URL=https://api.trongrid.io

# Ethereum (Etherscan API)
ETHERSCAN_API_KEY=
ETHERSCAN_API_URL=https://api.etherscan.io/api
ETH_RPC_URL=https://cloudflare-eth.com

# Solana (Helius API / RPC)
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com

# Tracing Engine Parameters
MAX_TRACE_HOPS=5
MAX_BRANCHING_FACTOR=10
DEFAULT_MIN_AMOUNT_USD=10.0
DUST_THRESHOLD_USD=2.0
TRACE_TIMEOUT_SECONDS=180

# Law Enforcement Notification & Webhooks
LEA_ORGANIZATION="State Cyber Crime Police / SIH26183"
ALERT_WEBHOOK_URL=http://localhost:8000/api/v1/alerts/test-webhook
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=cybercell-alerts@chainsleuth.gov.in
